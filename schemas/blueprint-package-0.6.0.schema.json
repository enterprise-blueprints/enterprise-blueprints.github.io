{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enterprise Blueprints Package 0.6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "idPrefix",
    "version",
    "title",
    "description",
    "publisher",
    "license",
    "publishedAt",
    "domain",
    "elements",
    "relations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.6.0"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9-]+)+$"
    },
    "idPrefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$",
      "description": "The first part of every element ID the package defines, such as \"eb\" in eb:capability:case-management. Each publisher uses its own, so IDs from different publishers never collide."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "publishedAt": {
      "type": "string",
      "format": "date"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "jurisdictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "description": "Packages this one builds on. Its relations and discovery answers can point at their elements by ID.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assessment"
      }
    },
    "playbooks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/playbook"
      }
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "version"
      ],
      "properties": {
        "packageId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9-]+)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*:[a-z][a-zA-Z]*:[a-z0-9][a-z0-9-]*$",
          "description": "The package’s ID prefix, the element’s type, and its key, as in eb:capability:case-management."
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "reference",
            "draft",
            "deprecated"
          ]
        },
        "replacedBy": {
          "type": "string"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "jurisdictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "applicabilityNotes": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "implementationPattern"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "attributes"
            ],
            "properties": {
              "attributes": {
                "$ref": "#/$defs/patternAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "outcome"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/outcomeAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "mission"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/missionAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "capability"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/capabilityAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "requirement"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "attributes": {
                "$ref": "#/$defs/requirementAttributes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "resource"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "attributes"
            ],
            "properties": {
              "attributes": {
                "$ref": "#/$defs/resourceAttributes"
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^src:[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "kind": {
          "enum": [
            "official-reference",
            "research",
            "background",
            "other"
          ]
        },
        "publicationDate": {
          "type": "string",
          "format": "date"
        },
        "lastReviewedAt": {
          "type": "string",
          "format": "date"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "predicate",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^rel:[a-z0-9][a-z0-9-]*$"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coverage": {
          "description": "For candidate_pattern: how much of the capability the pattern covers. Without it, the pattern covers it fully.",
          "enum": [
            "full",
            "partial"
          ]
        },
        "way": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "For depends_on: the way of sourcing the pattern that needs the other one. For helps_with: the way of sourcing the pattern the resource helps with. Without it, any way does."
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "single-choice",
            "multiple-choice",
            "text",
            "number",
            "boolean"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "candidateMappings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "answerValue",
              "elementId",
              "interpretation"
            ],
            "properties": {
              "answerValue": {
                "type": "string"
              },
              "elementId": {
                "type": "string"
              },
              "interpretation": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "questions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "review",
            "capture",
            "assess",
            "compare",
            "model",
            "deliver"
          ]
        },
        "description": {
          "type": "string"
        },
        "suggestedWhen": {
          "type": "object",
          "additionalProperties": true
        },
        "readinessCriterionIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputHints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "playbook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "title",
        "objectiveTags",
        "activities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objectiveTags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity"
          }
        }
      }
    },
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "patternAttributes": {
      "description": "What an implementation pattern says about itself, so patterns can be compared and grouped by the layer of a solution they belong to. A pattern is a logical part of a solution, with one or more ways to source it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "ways"
      ],
      "properties": {
        "layer": {
          "enum": [
            "public-facing",
            "ai-insights",
            "business-applications",
            "worker-productivity",
            "connections",
            "data-records",
            "security-identity"
          ],
          "description": "The layer of a solution the pattern belongs to."
        },
        "parts": {
          "$ref": "#/$defs/statements"
        },
        "strengths": {
          "$ref": "#/$defs/statements"
        },
        "fitsWhen": {
          "$ref": "#/$defs/statements"
        },
        "watchFor": {
          "$ref": "#/$defs/statements"
        },
        "ways": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/way"
          }
        }
      }
    },
    "way": {
      "description": "One way to source a pattern, such as configuring a product or extending a platform the agency has. A way's own strengths, fit, and what to watch for add to the pattern's.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "approach",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "approach": {
          "enum": [
            "product",
            "platform",
            "combine",
            "build"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "strengths": {
          "$ref": "#/$defs/statements"
        },
        "fitsWhen": {
          "$ref": "#/$defs/statements"
        },
        "watchFor": {
          "$ref": "#/$defs/statements"
        }
      }
    },
    "capabilityAttributes": {
      "description": "What a capability holds: its stage, the part of the work it belongs to. Other attributes pass.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "stage": {
          "enum": [
            "plan-prepare",
            "reach-take-in",
            "assess-decide",
            "deliver-operate",
            "monitor-correct",
            "report-close",
            "across-the-work"
          ],
          "description": "The stage of the work the capability belongs to, which groups capabilities across missions."
        }
      }
    },
    "requirementAttributes": {
      "description": "What a requirement holds: its kind of obligation. Other attributes pass.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "enum": [
            "timeliness",
            "checks-controls",
            "decisions-on-record",
            "privacy-security",
            "transparency-reporting",
            "service-access",
            "fairness-due-process"
          ],
          "description": "The kind of obligation the requirement is, which groups requirements across missions."
        }
      }
    },
    "outcomeAttributes": {
      "description": "What an outcome holds: its theme, the part of what the public gets it belongs to, and the measures that tell how it’s going.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "enum": [
            "timely",
            "fair-accessible",
            "easy-to-use",
            "integrity",
            "results",
            "accountable",
            "transparent"
          ],
          "description": "What the public gets from the outcome, which groups outcomes across missions."
        },
        "measures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/measure"
          }
        }
      }
    },
    "measure": {
      "description": "A way to tell how an outcome is going, such as a figure an office already reports.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "missionAttributes": {
      "description": "What a mission says about itself: its tagline, and the principles its architecture follows.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "tagline": {
          "type": "string",
          "minLength": 1
        },
        "principles": {
          "$ref": "#/$defs/statements"
        }
      }
    },
    "resourceAttributes": {
      "description": "What a resource holds: its kind, where to find it, and who made it. Other attributes, such as a service’s contract vehicle, pass.",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "url"
      ],
      "properties": {
        "kind": {
          "enum": [
            "video",
            "course",
            "guide",
            "site",
            "community",
            "dataset",
            "tool",
            "template",
            "demo",
            "service",
            "product",
            "case-study"
          ],
          "description": "What kind of resource it is, which groups resources across packages."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Where to find it."
        },
        "by": {
          "type": "string",
          "minLength": 1,
          "description": "Who made it, when that isn’t the package’s publisher."
        },
        "lastReviewedAt": {
          "type": "string",
          "format": "date",
          "description": "When the link and the description were last checked."
        }
      }
    }
  }
}
