---
import '../styles/site.css';
import { site } from '../site';
import { href } from '../lib/paths';
import { typesInUse } from '../lib/library';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const path = Astro.url.pathname;
const nav = [
  ...typesInUse().map(([, t]) => ({ label: t.navLabel, url: href(`${t.section}/`) })),
  { label: 'Sources', url: href('sources/') },
  { label: 'Data', url: href('data/') },
  { label: 'About', url: href('about/') },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href={href('')}>
          <svg class="brand__mark" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false"><rect x="3" y="4" width="20" height="6" rx="1.5" fill="currentColor" opacity=".45"/><rect x="3" y="13" width="20" height="6" rx="1.5" fill="currentColor"/><rect x="3" y="22" width="20" height="6" rx="1.5" fill="currentColor" opacity=".45"/><rect x="25" y="4" width="4" height="24" rx="1.5" fill="currentColor" opacity=".75"/></svg>
          <span>{site.title}</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a
                  href={item.url}
                  aria-current={path === item.url ? 'page' : undefined}
                  class={path !== item.url && path.startsWith(item.url) ? 'is-active' : undefined}
                >{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div class="site-footer__about">
          <p class="site-footer__title">{site.title}</p>
          <p>{site.description}</p>
          <p>Released under the MIT License.</p>
        </div>
        <nav class="site-footer__nav" aria-label="Footer">
          <ul>
            {nav.map((item) => <li><a href={item.url}>{item.label}</a></li>)}
            <li><a href={site.repositoryUrl}>Source on GitHub</a></li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
