---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import TypeBadge from '../../components/TypeBadge.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import ElementTable from '../../components/ElementTable.astro';
import SourceList from '../../components/SourceList.astro';
import MissionStack from '../../components/MissionStack.astro';
import OutcomeMatrix from '../../components/OutcomeMatrix.astro';
import PatternCompare from '../../components/PatternCompare.astro';
import {
  elements,
  lastReviewed,
  missionBlueprint,
  patternDetails,
  questionsAbout,
  relationGroups,
  solutionsFor,
  solutionView,
  sourcesOf,
  usedBy,
} from '../../lib/library';
import { patternFields, patternRoles, predicates, statuses } from '../../lib/vocabulary';
import { attributeLabel, attributeValue, formatDate } from '../../lib/format';
import { href } from '../../lib/paths';
import { downloadUrl } from '../../lib/publish';

export const getStaticPaths = (() =>
  elements.map((element) => ({
    params: { section: element.typeInfo.section, slug: element.slug },
    props: { element },
  }))) satisfies GetStaticPaths;

const { element } = Astro.props;
const pkg = element.package;
const groups = relationGroups(element);
const sources = sourcesOf(element);
const reviewed = lastReviewed(sources);
const scope = element.jurisdictions ?? pkg.jurisdictions ?? [];
const isPattern = element.type === 'implementationPattern';
// A pattern and a solution describe themselves with fields of their own, which get sections.
const pattern = isPattern || element.type === 'solution' ? patternDetails(element) : null;
const ownFields = ['approach', 'role', ...Object.keys(patternFields)];
const attributes = Object.entries(element.attributes ?? {}).filter(([key]) => !pattern || !ownFields.includes(key));
const questions = questionsAbout(element);
const users = usedBy(element);
// A mission shows everything under it, band by band, and which capabilities serve which outcomes.
const blueprint = element.type === 'mission' ? missionBlueprint(element) : null;
const solutions = element.type === 'mission' ? solutionsFor(element) : [];
const stacked = Boolean(blueprint?.capabilities.length);
// A solution shows its patterns by role and what it covers for each mission.
const solution = element.type === 'solution' ? solutionView(element) : null;
// The stack already shows the mission's outcomes, capabilities, and solutions, a capability compares its
// patterns, and a solution lays out its own.
const covered = [
  ...(stacked ? [predicates.seeks.outgoing, predicates.supports_mission.incoming, predicates.supports.incoming] : []),
  ...(solution ? [predicates.includes.outgoing, predicates.supports.outgoing] : []),
];
const patternGroup = groups.find((g) => g.heading === predicates.candidate_pattern.outgoing);
const perLink = [predicates.candidate_pattern.incoming, predicates.depends_on.outgoing, predicates.depends_on.incoming, predicates.works_with.outgoing];
const shownGroups = groups.filter((g) => g !== patternGroup && !covered.includes(g.heading));
---
<Base title={element.title} description={element.description}>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href={href('')}>Home</a></li>
        <li><a href={href(`${element.typeInfo.section}/`)}>{element.typeInfo.plural}</a></li>
        <li aria-current="page">{element.title}</li>
      </ol>
    </nav>

    <header class="record-header">
      <div class="record-header__meta">
        <TypeBadge type={element.type} />
        <StatusBadge status={element.status} />
        {pattern?.role && <span class="approach-badge">{patternRoles[pattern.role].label}</span>}
        {pattern?.approach && <span class="approach-badge">{pattern.approach}</span>}
      </div>
      <h1>{element.title}</h1>
      <p class="lede">{element.description}</p>
    </header>

    <div class="record-layout">
      <div class="record-main">
        {stacked && <MissionStack blueprint={blueprint!} solutions={solutions} />}

        {solution && pattern && (
          <div class="pattern-fields pattern-fields--solution">
            {pattern.fields.map((f) => (
              <section class={`pattern-field pattern-field--${f.key}`}>
                <h2>{f.label}</h2>
                <ul>{f.items.map((s) => <li>{s}</li>)}</ul>
              </section>
            ))}
          </div>
        )}

        {solution && (
          <section class="section">
            <h2>How it fits together</h2>
            <p class="section-note">
              The patterns it combines, by the part each one plays, for {solution.missions.map((m) => m.title).join(' and ')}.
            </p>
            {solution.roles.map((g) => (
              <div class="solution-role">
                <h3>{g.label}</h3>
                {g.hint && <p class="section-note">{g.hint}</p>}
                <ElementTable
                  elements={g.items.map((i) => i.pattern)}
                  notes={new Map(g.items.flatMap((i) => (i.note ? [[i.pattern.id, i.note] as const] : [])))}
                />
              </div>
            ))}
          </section>
        )}

        {solution && (
          <section class="section">
            <h2>What it covers</h2>
            <p class="section-note">
              For each mission, the capabilities that one of its patterns might help realize, the ones its patterns cover only part of, and the ones it has
              no pattern for yet.
            </p>
            {solution.missing.length > 0 && (
              <div class="notice">
                {solution.missing.map((m) => (
                  <p>
                    <a href={m.pattern.url}>{m.pattern.title}</a> isn’t included, but {m.neededBy.map((p) => p.title).join(' and ')} {m.neededBy.length === 1 ? 'needs' : 'need'} it.
                  </p>
                ))}
              </div>
            )}
            <div class="coverage">
              {solution.coverage.map((c) => (
                <article class="coverage__mission">
                  <h3><a href={c.mission.url}>{c.mission.title}</a></h3>
                  <p class="coverage__count">
                    Covers <strong>{c.covered.length + c.partly.length}</strong> of {c.covered.length + c.partly.length + c.uncovered.length} capabilities{c.partly.length > 0 && <>, <strong>{c.partly.length}</strong> of them only partly</>}
                  </p>
                  <ul class="element-links">
                    {c.covered.map((cap) => <li><a class="element-link type-capability" href={cap.url}>{cap.title}</a></li>)}
                  </ul>
                  {c.partly.length > 0 && (
                    <>
                      <p class="coverage__gap">Partly covered</p>
                      <ul class="element-links">
                        {c.partly.map((cap) => <li><a class="element-link type-capability" href={cap.url}>{cap.title}</a></li>)}
                      </ul>
                    </>
                  )}
                  {c.uncovered.length > 0 && (
                    <>
                      <p class="coverage__gap">No pattern yet for</p>
                      <ul class="element-links">
                        {c.uncovered.map((cap) => <li><a class="element-link type-capability coverage__uncovered" href={cap.url}>{cap.title}</a></li>)}
                      </ul>
                    </>
                  )}
                </article>
              ))}
            </div>
          </section>
        )}

        {blueprint && blueprint.outcomes.length > 0 && blueprint.capabilities.length > 0 && (
          <section class="section">
            <h2>How capabilities serve the outcomes</h2>
            <p class="section-note">Each dot is a capability that contributes to that outcome.</p>
            <OutcomeMatrix blueprint={blueprint} />
          </section>
        )}

        {element.applicabilityNotes && (
          <div class="notice">
            <p><strong>Applicability.</strong> {element.applicabilityNotes}</p>
          </div>
        )}

        {pattern && !solution && pattern.fields.length > 0 && (
          <div class="pattern-fields">
            {pattern.fields.map((f) => (
              <section class={`pattern-field pattern-field--${f.key}`}>
                <h2>{f.label}</h2>
                <ul>{f.items.map((s) => <li>{s}</li>)}</ul>
              </section>
            ))}
          </div>
        )}

        {shownGroups.map((g) => {
          // Links between capabilities and patterns, and between patterns, each say something of their own,
          // such as a mission's caveat or how much of a capability a pattern covers.
          const perRow = perLink.includes(g.heading);
          const notes = perRow ? new Map([...g.links].flatMap(([id, l]) => (l.note ? [[id, l.note] as const] : []))) : undefined;
          const partial = perRow ? new Set([...g.links].flatMap(([id, l]) => (l.partial ? [id] : []))) : undefined;
          return (
            <section class="section">
              <h2>{g.heading}</h2>
              {!perRow && g.notes.map((n) => <p class="section-note">{n}</p>)}
              <ElementTable elements={g.elements} notes={notes} partial={partial} />
            </section>
          );
        })}

        {patternGroup && (
          <section class="section">
            <h2>Compare the candidate patterns</h2>
            <p class="section-note">
              Example approaches that might realize this capability, with when each one fits and what to watch for.
            </p>
            <PatternCompare capability={element} patterns={patternGroup.elements} />
          </section>
        )}

        {questions.length > 0 && (
          <section class="section">
            <h2>Discovery questions</h2>
            <p class="section-note">Answers to these questions point here.</p>
            <ul class="discovery-list">
              {questions.map(({ question, answers }) => (
                <li>
                  <a class="text-link" href={question.url}>{question.prompt}</a>
                  <ul>
                    {answers.map((a) => (
                      <li><strong>{a.label}.</strong> <span class="muted">{a.interpretation}</span></li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </section>
        )}

        {sources.length > 0 && (
          <section class="section">
            <h2>Sources</h2>
            <SourceList sources={sources} />
          </section>
        )}
      </div>

      <aside class="record-aside" aria-label="Details">
        <dl class="facts">
          <div><dt>ID</dt><dd><code class="element-id">{element.id}</code></dd></div>
          <div><dt>Type</dt><dd>{element.typeInfo.label}</dd></div>
          {element.status && <div><dt>Status</dt><dd>{statuses[element.status]}</dd></div>}
          <div>
            <dt>Package</dt>
            <dd>
              {pkg.title} <span class="muted">v{pkg.version}</span>
              <div><a href={downloadUrl(pkg)}>Download JSON</a></div>
            </dd>
          </div>
          {users.length > 0 && <div><dt>Also used by</dt><dd>{users.map((p) => p.title).join('; ')}</dd></div>}
          {scope.length > 0 && <div><dt>Scope</dt><dd>{scope.join('; ')}</dd></div>}
          {reviewed && <div><dt>Sources reviewed</dt><dd>{formatDate(reviewed)}</dd></div>}
          {attributes.length > 0 && (
            <div>
              <dt>Attributes</dt>
              <dd>
                {attributes.map(([key, value]) => (
                  <div>{attributeLabel(key)}: <span class="muted">{attributeValue(value)}</span></div>
                ))}
              </dd>
            </div>
          )}
        </dl>
      </aside>
    </div>
  </div>
</Base>

<style>
  .discovery-list { list-style: none; margin: 0; padding: 0; display: grid; gap: .9rem; }
  .discovery-list > li > a { font-weight: 600; }
  .discovery-list ul { margin: .3rem 0 0; padding-left: 1.1rem; display: grid; gap: .2rem; font-size: .95rem; }
  .approach-badge { font-size: .8125rem; font-weight: 600; padding: .15rem .55rem; border-radius: 999px; border: 1px solid var(--border); background: var(--surface-muted); }
  .pattern-fields { display: grid; gap: 1rem; margin-bottom: 2rem; }
  @media (min-width: 46rem) { .pattern-fields { grid-template-columns: 1fr 1fr; } }
  .pattern-field { padding: 1rem 1.15rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .pattern-field--parts, .pattern-field--watchFor { grid-column: 1 / -1; }
  /* A solution has only these two, side by side. */
  .pattern-fields--solution .pattern-field--watchFor { grid-column: auto; }
  .pattern-field h2 { margin: 0 0 .5rem; font-size: 1rem; }
  .pattern-field ul { margin: 0; padding-left: 1.1rem; display: grid; gap: .35rem; }
  .solution-role { margin-top: 1.5rem; }
  .solution-role h3 { margin-bottom: .2rem; }
  .solution-role .section-note { margin: 0; }
  .coverage { display: grid; gap: 1rem; }
  @media (min-width: 46rem) { .coverage { grid-template-columns: 1fr 1fr; } }
  .coverage__mission { padding: 1rem 1.15rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .coverage__mission h3 { font-size: 1rem; margin-bottom: .2rem; }
  .coverage__count { margin: 0 0 .6rem; font-size: .9375rem; color: var(--text-muted); }
  .coverage__mission .element-links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .35rem; }
  .coverage__mission .element-link { font-size: .875rem; }
  .coverage__gap { margin: .9rem 0 .35rem; font-size: .75rem; font-weight: 650; letter-spacing: .04em; text-transform: uppercase; color: var(--text-muted); }
  .coverage__uncovered { border-style: dashed; opacity: .8; }
</style>
