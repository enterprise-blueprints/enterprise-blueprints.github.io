---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import hero from '../assets/hero.png';
import TypeBadge from '../components/TypeBadge.astro';
import { dependents, elementsOfType, tagline, missionBlueprint, packages, shortTitle, solutionView, sourcesOf, lastReviewed, typesInUse } from '../lib/library';
import { formatDate, plural } from '../lib/format';
import { href } from '../lib/paths';

const missions = elementsOfType('mission')
  .sort((a, b) => a.title.localeCompare(b.title))
  .map((m) => {
    const { outcomes, capabilities, patterns } = missionBlueprint(m);
    const reviewed = lastReviewed(sourcesOf(m));
    return { ...m, outcomes, capabilities, patterns, reviewed };
  });
const first = missions[0];
// Packages that missions build on, with what they offer. Mission packages, which solutions build on, aren't these.
const hasMission = (pkg: (typeof packages)[number]) => pkg.elements.some((e) => e.type === 'mission');
const shared = packages
  .filter((pkg) => !hasMission(pkg))
  .map((pkg) => ({ pkg, users: dependents(pkg).filter(hasMission), capabilities: elementsOfType('capability').filter((c) => c.package === pkg) }))
  .filter((s) => s.users.length > 0 && s.capabilities.length > 0);
const solutions = elementsOfType('solution').map(solutionView);
// "Federal FOIA Program", from its package's title.
const shortMission = (mission: (typeof solutions)[number]['missions'][number]) => shortTitle(mission.package);
---
<Base>
  <section class="hero hero--art">
    <Picture class="hero__art" src={hero} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[800, 1280, 1672]} sizes="100vw" alt="" loading="eager" fetchpriority="high" />
    <div class="container hero__content">
      <p class="kicker">An independent, open reference library</p>
      <h1 class="hero__title">Reference blueprints for public-sector missions</h1>
      <p class="hero__lede">
        Enterprise Blueprints describes what public organizations are responsible for, the capabilities that
        work depends on, and example patterns that might realize them. Every page links to its sources.
      </p>
      <p class="hero__actions">
        {missions.length === 1
          ? <a class="button button--primary" href={first.url}>Explore the mission</a>
          : <a class="button button--primary" href={href('missions/')}>Browse missions</a>}
        <a class="button" href={href('capabilities/')}>Browse capabilities</a>
      </p>
    </div>
  </section>

  <section class="section-band" aria-labelledby="missions-heading">
    <div class="container">
      <div class="section-intro">
        <h2 id="missions-heading">Missions</h2>
        <p>
          Each mission describes a type of public organization. Start from a mission and follow it to the
          outcomes it seeks, how to measure them, and the capabilities they rely on.
        </p>
      </div>
      <div class="mission-grid">
        {missions.map((m) => (
          <article class={`card type-${m.type}`}>
            <div class="card__meta"><TypeBadge type={m.type} /></div>
            <h3 class="card__title"><a href={m.url}>{m.title}</a></h3>
            {tagline(m) && <p class="card__tagline">{tagline(m)}</p>}
            <p class="card__summary">{m.description}</p>
            <ul class="card__facts">
              {m.outcomes.length > 0 && <li><strong>{m.outcomes.length}</strong> {m.outcomes.length === 1 ? 'outcome' : 'outcomes'}</li>}
              <li><strong>{m.capabilities.length}</strong> {m.capabilities.length === 1 ? 'capability' : 'capabilities'}</li>
              <li><strong>{m.patterns.length}</strong> candidate {m.patterns.length === 1 ? 'pattern' : 'patterns'}</li>
              {m.reviewed && <li>Sources reviewed {formatDate(m.reviewed)}</li>}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  {shared.length > 0 && (
    <section class="section-band" aria-labelledby="shared-heading">
      <div class="container">
        <div class="section-intro">
          <h2 id="shared-heading">Shared across missions</h2>
          <p>
            Some capabilities, such as identity, data protection, and case management, matter to many missions. They're described once,
            and mission packages build on them instead of repeating them.
          </p>
        </div>
        <div class="mission-grid">
          {shared.map(({ pkg, users, capabilities }) => (
            <article class="card">
              <h3 class="card__title">{pkg.title}</h3>
              <ul class="shared-list">
                {capabilities.map((c) => (
                  <li><a class={`element-link type-${c.type}`} href={c.url}>{c.title}</a></li>
                ))}
              </ul>
              <p class="muted">Used by {users.map((u) => u.title).join('; ')}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {solutions.length > 0 && (
    <section class="section-band" aria-labelledby="solutions-heading">
      <div class="container">
        <div class="section-intro">
          <h2 id="solutions-heading">Example solutions</h2>
          <p>
            Ways an agency could combine patterns across its missions, from one shared platform to purpose-built
            systems for each office, with what each one covers and what to watch for.
          </p>
        </div>
        <div class="mission-grid">
          {solutions.map((s) => (
            <article class="card type-solution">
              <div class="card__meta"><TypeBadge type="solution" /></div>
              <h3 class="card__title"><a href={s.solution.url}>{s.solution.title}</a></h3>
              <p class="card__summary">{s.solution.description}</p>
              <ul class="card__facts">
                <li><strong>{s.patterns.length}</strong> patterns</li>
                {s.coverage.map((c) => (
                  <li><strong>{c.covered.length}</strong> of {c.covered.length + c.uncovered.length} {shortMission(c.mission)} capabilities</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section-band section-band--muted" aria-labelledby="library-heading">
    <div class="container">
      <div class="section-intro">
        <h2 id="library-heading">How the library is organized</h2>
        <p>
          The library uses a small shared vocabulary. Each item has a stable ID and typed links to related
          items, so people and tools can follow the same connections.
        </p>
      </div>
      <ul class="type-list">
        {typesInUse().map(([type, t]) => (
          <li>
            <a class={`element-link type-${type}`} href={href(`${t.section}/`)}>
              {t.plural} <span class="type-list__count">({plural(elementsOfType(type).length, 'item', 'items')})</span>
            </a>
            <p>{t.definition}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
