{
  "name": "enterprise-blueprints",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "content:build": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/content.ts build",
    "content:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/content.ts check",
    "check:dist": "node scripts/check-dist.mjs dist",
    "check:published": "node scripts/check-published.mjs dist",
    "verify": "pnpm content:check && pnpm check && pnpm test && pnpm build && pnpm check:dist"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "6.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22",
    "sharp": "0.34.5",
    "typescript": "^6",
    "vitest": "^5.0.5",
    "yaml": "2.9.1"
  }
}
