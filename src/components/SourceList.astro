---
import type { Source } from '../lib/package';
import { sourceKinds } from '../lib/vocabulary';
import { formatDate } from '../lib/format';

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---
<ul class="source-list">
  {sources.map((s) => (
    <li>
      <a class="source-list__title" href={s.url}>{s.title}</a>
      <p class="source-list__meta">
        {sourceKinds[s.kind]}{s.lastReviewedAt && ` · Reviewed ${formatDate(s.lastReviewedAt)}`}
        {s.note && <><br />{s.note}</>}
      </p>
    </li>
  ))}
</ul>
