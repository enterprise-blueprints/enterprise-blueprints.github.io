---
// What opens over the explorer's panel when a resource is chosen: all about it,
// with a button that opens it in a new tab. Each resource is here once, however
// many items it helps with, and the explorer's script shows the one chosen.
import { helpsWith, resourceDetails, type LibraryElement } from '../lib/library';
import { attributeLabel, attributeValue, formatDate } from '../lib/format';
import { groupings, resourceFields } from '../lib/vocabulary';
import LibraryMark from './LibraryMark.astro';

interface Props {
  resources: LibraryElement[];
}

const { resources } = Astro.props;
const placed = [...resourceFields, groupings.resource.field];
const extras = (r: LibraryElement) => Object.entries(r.attributes ?? {}).filter(([key]) => !placed.includes(key));
---
<dialog class="ex-drawer" data-drawer aria-label="Resource">
  <div class="ex-drawer__body">
    <button type="button" class="ex-drawer__close" data-drawer-close aria-label="Close">✕</button>
    {resources.map((r) => {
      const details = resourceDetails(r);
      return (
        <div class="ex-drawer__detail type-resource" data-resource-detail={r.id} data-resource-id={r.id} hidden>
          <p class="ex-drawer__kind">{details.kind}</p>
          <h3>{r.title}<LibraryMark element={r} always /></h3>
          <p class="ex-drawer__by">By {details.by ?? r.package.publisher.name}{details.lastReviewedAt && <> · Checked {formatDate(details.lastReviewedAt)}</>}</p>
          <p>{r.description}</p>
          <p class="ex-drawer__here" data-here hidden></p>
          <p><a class="button button--primary" href={details.url} target="_blank" rel="noopener">Go to the {details.kind.toLowerCase()}<span aria-hidden="true">&nbsp;↗</span><span class="sr-only"> (opens in a new tab)</span></a></p>
          {extras(r).length > 0 && (
            <dl class="ex-drawer__facts">
              {extras(r).map(([key, value]) => <div><dt>{attributeLabel(key)}</dt><dd>{attributeValue(value)}</dd></div>)}
            </dl>
          )}
          <h4>What it helps with</h4>
          <div class="element-links">
            {helpsWith(r).map(({ element, way }) => <a class={`element-link type-${element.type}`} href={way ? `${element.url}#way-${way.id}` : element.url}><span>{element.title}<LibraryMark element={element} /></span></a>)}
          </div>
          <p class="ex-drawer__more"><a href={r.url}>See its page →</a></p>
        </div>
      );
    })}
  </div>
</dialog>

<style>
  .ex-drawer { width: min(27rem, 100vw); height: 100dvh; max-width: none; max-height: none; margin: 0 0 0 auto; padding: 0; border: 0; border-left: 1px solid var(--border-strong); background: var(--surface); color: var(--text); box-shadow: -12px 0 32px rgb(0 0 0 / .2); }
  .ex-drawer[open] { animation: ex-drawer-in .18s ease-out; }
  .ex-drawer::backdrop { background: rgb(0 0 0 / .3); }
  @keyframes ex-drawer-in { from { transform: translateX(100%); } }
  @media (prefers-reduced-motion: reduce) { .ex-drawer[open] { animation: none; } }

  /* The body fills the drawer, so a click on the dialog itself is always on the backdrop. */
  .ex-drawer__body { position: relative; box-sizing: border-box; height: 100%; overflow-y: auto; padding: 1.25rem 1.4rem 1.5rem; }
  .ex-drawer__close { position: sticky; top: 0; float: right; margin: -.25rem -.4rem 0 .5rem; padding: .25rem .5rem; border: 0; border-radius: var(--radius-sm); background: var(--surface-muted); color: var(--text); font: inherit; cursor: pointer; }
  .ex-drawer__detail p { margin: 0 0 .8rem; }
  .ex-drawer__detail h3 { margin: 0 0 .3rem; font-size: 1.3125rem; line-height: 1.3; }
  .ex-drawer__detail h4 { margin: 1.25rem 0 .45rem; font-size: .75rem; font-weight: 650; letter-spacing: .04em; text-transform: uppercase; color: var(--text-muted); }
  .ex-drawer__detail .ex-drawer__kind { margin-bottom: .3rem; font-size: .875rem; font-weight: 650; color: var(--tc); }
  .ex-drawer__by { color: var(--text-muted); font-size: .9375rem; }
  .ex-drawer__here { padding: .5rem .7rem; border-left: 3px solid var(--tc); border-radius: var(--radius-sm); background: var(--tc-bg); font-size: .9375rem; }
  .ex-drawer__facts { display: grid; gap: .5rem; margin: 1.1rem 0 0; }
  .ex-drawer__facts dt { font-size: .75rem; font-weight: 650; letter-spacing: .04em; text-transform: uppercase; color: var(--text-muted); }
  .ex-drawer__facts dd { margin: 0; }
  .ex-drawer__detail .ex-drawer__more { margin: 1.1rem 0 0; font-weight: 600; }
</style>
