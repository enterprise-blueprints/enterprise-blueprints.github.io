---
// A small book after an item's name, on a publisher's site, for an item from
// the library among the publisher's own. With `within`, the package of the
// page or mission it's shown in, a library page's own library items go
// unmarked, since the page already says where it's from. With `always`, it
// marks one item on its own, such as a page's title or the explorer panel's.
// The library's own site shows none.
import { fromLibrary, upstream } from '../lib/library';
import type { BlueprintPackage } from '../lib/package';

interface Props {
  element: { package: BlueprintPackage };
  within?: BlueprintPackage;
  /** Show it even on a library page, for one item on its own, such as the page's title. */
  always?: boolean;
  /** Just the book, for a legend that says what it means. */
  legend?: boolean;
}

const { element, within, always, legend } = Astro.props;
const show = always || legend ? fromLibrary(element) : fromLibrary(element, within);
---
{show && legend && (
  <span class="library-mark library-mark--legend">
    <span class="sr-only">A book</span>
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 4.3C6.5 3.2 4.5 2.8 1.8 3v9.2c2.7-.2 4.7.2 6.2 1.3 1.5-1.1 3.5-1.5 6.2-1.3V3C11.5 2.8 9.5 3.2 8 4.3Zm0 0v9.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
  </span>
)}
{show && !legend && (
  <span class="library-mark" title={`From ${upstream!.title}`}>{'\u2060'}<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 4.3C6.5 3.2 4.5 2.8 1.8 3v9.2c2.7-.2 4.7.2 6.2 1.3 1.5-1.1 3.5-1.5 6.2-1.3V3C11.5 2.8 9.5 3.2 8 4.3Zm0 0v9.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
    <span class="sr-only">, from {upstream!.title}</span>
  </span>
)}
