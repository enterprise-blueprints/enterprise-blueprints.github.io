---
import '../styles/site.css';
import { site } from '../site';
import { href } from '../lib/paths';
import { assessments, typesInUse } from '../lib/library';
import SiteSearch from '../components/SiteSearch.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const path = Astro.url.pathname;
// The element types, Discovery, and Sources, then the site's own pages. A link to another site opens in a new tab.
const nav = [
  ...typesInUse().map(([, t]) => ({ label: t.navLabel, url: href(`${t.section}/`), external: false })),
  ...(assessments.length ? [{ label: 'Discovery', url: href('discovery/'), external: false }] : []),
  { label: 'Sources', url: href('sources/'), external: false },
  ...site.nav.map((item) => ({ label: item.label, url: item.url ?? href(item.path ?? ''), external: Boolean(item.url) })),
];
const newTab = (external: boolean) => (external ? { target: '_blank', rel: 'noopener' } : {});
// A site with a color of its own, for links and buttons, softened for the dark theme. The doubled
// :root outranks the stylesheet's, which loads after it.
const accent = site.accent
  ? `:root:root { --accent: ${site.accent}; --accent-strong: color-mix(in srgb, ${site.accent} 80%, black); --accent-soft: color-mix(in srgb, ${site.accent} 10%, white); }
@media (prefers-color-scheme: dark) { :root:root { --accent: color-mix(in srgb, ${site.accent} 55%, white); --accent-strong: color-mix(in srgb, ${site.accent} 35%, white); --accent-soft: color-mix(in srgb, ${site.accent} 22%, #111827); } }`
  : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    {accent && <style is:inline set:html={accent} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" data-site-header>
      <div class="container site-header__inner">
        <a class="brand" href={href('')}>
          <svg class="brand__mark" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false"><rect x="3" y="4" width="20" height="6" rx="1.5" fill="currentColor" opacity=".45"/><rect x="3" y="13" width="20" height="6" rx="1.5" fill="currentColor"/><rect x="3" y="22" width="20" height="6" rx="1.5" fill="currentColor" opacity=".45"/><rect x="25" y="4" width="4" height="24" rx="1.5" fill="currentColor" opacity=".75"/></svg>
          <span>{site.title}</span>
        </a>
        <SiteSearch />
        {/* On a phone the nav folds behind this button. Without scripts it stays open. */}
        <button type="button" class="site-nav__toggle" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          <span>Menu</span>
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a
                  href={item.url}
                  aria-current={path === item.url ? 'page' : undefined}
                  class={path !== item.url && path.startsWith(item.url) ? 'is-active' : undefined}
                  {...newTab(item.external)}
                >{item.label}{item.external && <span class="sr-only"> (opens in a new tab)</span>}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <script>
      // The phone menu: the button opens and closes the nav, and Escape closes it.
      const header = document.querySelector<HTMLElement>('[data-site-header]')!;
      const toggle = header.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
      const set = (open: boolean) => {
        header.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', String(open));
      };
      header.classList.add('has-menu');
      toggle.addEventListener('click', () => set(!header.classList.contains('is-open')));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && header.classList.contains('is-open')) {
          set(false);
          toggle.focus();
        }
      });
    </script>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div class="site-footer__about">
          <p class="site-footer__title">{site.title}</p>
          <p>{site.description}</p>
          {site.footer && <p>{site.footer}</p>}
        </div>
        <nav class="site-footer__nav" aria-label="Footer">
          <ul>
            {nav.map((item) => <li><a href={item.url} {...newTab(item.external)}>{item.label}{item.external && <span class="sr-only"> (opens in a new tab)</span>}</a></li>)}
            {site.links?.map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.label}<span class="sr-only"> (opens in a new tab)</span></a></li>)}
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
