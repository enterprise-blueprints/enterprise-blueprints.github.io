---
// One outcome or capability in a mission's stack: a chip that selects it,
// its description, what sits under it (shown while it's selected), and a
// link to its page.
import { shortTitle, type LibraryElement } from '../lib/library';

interface Props {
  element: LibraryElement;
  meta?: string;
  /** From a package the mission builds on. */
  shared?: boolean;
  /** What sits under it in the stack, such as an outcome's measures. */
  below: { heading: string; elements: { title: string; url: string; type: string }[] }[];
  'data-node': string;
  'data-links': string;
}

const { element, meta, shared, below, ...data } = Astro.props;
---
<li class="bp-item" {...data}>
  <button
    type="button"
    class:list={['element-link', `type-${element.type}`, 'bp-chip', shared && 'bp-chip--shared']}
    aria-pressed="false"
    data-select
    title={shared ? `From ${shortTitle(element.package)}` : undefined}
  >
    <span>{element.title}</span>
    {meta && <span class="bp-chip__meta">{meta}</span>}
  </button>
  <div class="bp-item__text">
    <p class="bp-item__desc">{element.description}</p>
    {below.some((b) => b.elements.length) && (
      <div class="bp-item__below">
        {below.filter((b) => b.elements.length).map((b) => (
          <div>
            <span class="bp-item__below-heading">{b.heading}</span>
            <ul class="element-links">
              {b.elements.map((e) => <li><a class={`element-link type-${e.type}`} href={e.url}>{e.title}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    )}
    <a class="bp-item__open" href={element.url}>Open page<span class="sr-only">: {element.title}</span> →</a>
  </div>
</li>
