---
import type { LibraryElement } from '../lib/library';

interface Props {
  elements: LibraryElement[];
  /** What the link to each element says, by element ID, shown under its description. */
  notes?: Map<string, string>;
  /** Candidate patterns, or their capabilities, where the pattern covers only part of the capability. */
  partial?: Set<string>;
}

const { elements, notes, partial } = Astro.props;
---
<div class="table-wrap">
  <table class="stack-table element-table">
    <thead>
      <tr><th scope="col">Name</th><th scope="col">Description</th></tr>
    </thead>
    <tbody>
      {elements.map((e) => (
        <tr>
          <th scope="row"><a class={`element-link type-${e.type}`} href={e.url}>{e.title}</a></th>
          <td class="muted">
            {e.description}
            {partial?.has(e.id) && <p class="element-table__note"><span class="partial-badge">Covers part of it</span></p>}
            {notes?.get(e.id) && <p class="element-table__note"><strong>Here:</strong> {notes.get(e.id)}</p>}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  /* Every button fills the column and fits two lines, so they're all one size. */
  .element-table .element-link { display: flex; width: 100%; min-height: 3.25rem; }
  .element-table__note { margin: .45rem 0 0; color: var(--text); font-size: .875rem; }
  @media (min-width: 46rem) {
    .element-table th[scope='row'] { width: 34%; }
  }
</style>
