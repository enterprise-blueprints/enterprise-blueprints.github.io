  "elements": [
    {
      "id": "eb:solution:agency-shared-platform",
      "type": "solution",
      "title": "Agency Shared Platform",
      "description": "An example solution: the OIG and the FOIA office both track their work on the agency’s shared case platform, each with its own case types and its own administration. The OIG adds a confidential hotline and audit management, the FOIA office adds a review tool, eDiscovery search, and the national portal, and everyone signs in the same way.",
      "status": "reference",
      "attributes": {
        "fitsWhen": [
          "The agency’s platform team can support several offices",
          "Keeping licenses, skills, and security approvals in one place matters more than a close fit for each office",
          "The offices’ work is fairly standard"
        ],
        "watchFor": [
          "The OIG’s independence depends on keeping its administration and access apart from the agency’s",
          "FOIA’s working-day deadlines and the OIG’s evidence handling need building on the platform",
          "One platform’s upgrades and outages affect every office at once"
        ]
      }
    },
    {
      "id": "eb:solution:purpose-built-systems",
      "type": "solution",
      "title": "Purpose-Built Systems for Each Office",
      "description": "An example solution: the OIG and the FOIA office each run a product made for their work, and share only the agency’s sign-on. Each product brings its own intake, reporting, and publishing, so each office can change its own system on its own schedule.",
      "status": "reference",
      "attributes": {
        "fitsWhen": [
          "The offices’ work is specialized, such as investigations with evidence, or high volumes of FOIA requests",
          "The OIG needs a system the agency doesn’t administer",
          "There’s budget for more than one product, and administrators in each office"
        ],
        "watchFor": [
          "More products to buy, secure, and keep up",
          "Reporting across offices means pulling from several systems",
          "Each product’s data needs its own records schedule and exports"
        ]
      }
    },
    {
      "id": "eb:solution:dedicated-oversight-shared-foia",
      "type": "solution",
      "title": "Dedicated Oversight System, Shared Platform for FOIA",
      "description": "An example solution: the OIG runs its own oversight case product, kept apart from the agency’s systems, while the FOIA office tracks requests on the agency’s shared platform with a separate review tool. Both sign in through the agency.",
      "status": "reference",
      "attributes": {
        "fitsWhen": [
          "The OIG’s independence calls for its own system, but the FOIA office is well served by the agency’s platform",
          "The agency wants to limit the number of products without putting the OIG on a shared system"
        ],
        "watchFor": [
          "Two ways of tracking work to support",
          "The FOIA office depends on the platform team for changes, such as new deadline rules"
        ]
      }
    }
  ],
