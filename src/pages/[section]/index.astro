---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ElementTable from '../../components/ElementTable.astro';
import { elementsOfType, typesInUse } from '../../lib/library';

export const getStaticPaths = (() =>
  typesInUse().map(([type, info]) => ({ params: { section: info.section }, props: { type, info } }))) satisfies GetStaticPaths;

const { type, info } = Astro.props;
const items = elementsOfType(type);
---
<Base title={info.plural} description={info.definition}>
  <div class="container">
    <header class="page-header">
      <h1>{info.plural}</h1>
      <p class="lede">{info.definition}</p>
    </header>
    <ElementTable elements={items} />
  </div>
</Base>
