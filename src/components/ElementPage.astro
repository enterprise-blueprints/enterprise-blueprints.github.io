---
import Base from '../layouts/Base.astro';
import TypeBadge from './TypeBadge.astro';
import StatusBadge from './StatusBadge.astro';
import ElementTable from './ElementTable.astro';
import SourceList from './SourceList.astro';
import MissionExplorer from './MissionExplorer.astro';
import OutcomeMatrix from './OutcomeMatrix.astro';
import PatternCompare from './PatternCompare.astro';
import ResourceList from './ResourceList.astro';
import LibraryMark from './LibraryMark.astro';
import {
  componentsOf,
  downloadUrl,
  elements,
  hostingOf,
  groupOf,
  lastReviewed,
  measuresOf,
  missionBlueprint,
  principlesOf,
  patternDetails,
  questionsAbout,
  relationGroups,
  resourceDetails,
  SOLUTIONS_NEEDING,
  resourcesFor,
  scopeLabel,
  sourcesOf,
  tagline,
  upstream,
  usedBy,
  type LibraryElement,
} from '../lib/library';
import { componentTiers, exposures, groupings, patternFields, patternLayers, predicates, resourceFields, statuses } from '../lib/vocabulary';
import { attributeLabel, attributeValue, formatDate } from '../lib/format';

/** Where to read about an element, who made it, and when that was checked. */
const resourceFieldsOf = (e: LibraryElement) => {
  const a = e.attributes ?? {};
  const text = (v: unknown) => (typeof v === 'string' && v ? v : undefined);
  return { url: String(a.url), by: text(a.by), lastReviewedAt: text(a.lastReviewedAt) };
};
import { href } from '../lib/paths';

interface Props {
  element: LibraryElement;
}

// An element's page. On a publisher's site, a library element's page says so
// and links to the library's own.
const { element } = Astro.props;
const pkg = element.package;
const groups = relationGroups(element);
const sources = sourcesOf(element);
const reviewed = lastReviewed(sources);
const scope = element.jurisdictions ?? pkg.jurisdictions ?? [];
const isPattern = element.type === 'implementationPattern';
// A pattern, and a solution that implements one, describe themselves with fields of their own, which get sections.
const pattern = isPattern ? patternDetails(element) : null;
const solution = element.type === 'solution' ? patternDetails(element) : null;
const ownFields = ['approach', 'layer', 'role', 'ways', 'components', 'hostedBy', ...Object.keys(patternFields)];
// A solution's parts, by tier, and who runs it, since schema 0.8.0.
const components = solution ? componentsOf(element) : [];
const tiers = Object.entries(componentTiers).map(([key, t]) => ({ ...t, key, parts: components.filter((c) => c.tier === key) })).filter((t) => t.parts.length);
const hosting = solution ? hostingOf(element) : undefined;
const fields = (pattern ?? solution)?.fields ?? [];
// A pattern's solutions, since schema 0.7.0, each with a page of its own; before then, its ways.
const solutions = pattern?.ways.some((w) => w.solution);
// A solution from an organization, such as a product, can say where to read about it.
const link = solution && typeof element.attributes?.url === 'string' ? resourceFieldsOf(element) : null;
// A mission's tagline and principles, an outcome's measures, and the group an item names have places of their own.
const placed = ['tagline', 'principles', 'measures', ...resourceFields, ...Object.values(groupings).map((g) => g.field)];
const attributes = Object.entries(element.attributes ?? {}).filter(([key]) => (!(pattern || solution) || !ownFields.includes(key)) && !placed.includes(key));
// An outcome's theme, a capability's stage, or a requirement's kind, linking to its group on the index page.
const group = groupOf(element);
const line = tagline(element);
const questions = questionsAbout(element);
const users = usedBy(element);
// A mission shows everything under it, band by band, and which capabilities serve which outcomes.
const blueprint = element.type === 'mission' ? missionBlueprint(element) : null;
const principles = element.type === 'mission' ? principlesOf(element) : [];
const measures = element.type === 'outcome' ? measuresOf(element) : [];
const stacked = Boolean(blueprint?.capabilities.length);
// A resource links out; the resources that help with anything else are listed as cards.
const resource = element.type === 'resource' ? resourceDetails(element) : null;
const resources = resourcesFor(element);
const canHaveResources = predicates.helps_with.to.includes(element.type);
const replacement = element.replacedBy ? elements.find((e) => e.id === element.replacedBy) : undefined;
// The stack already shows the mission's outcomes and capabilities, and a capability compares its patterns.
const covered = [predicates.helps_with.incoming, ...(solutions ? [predicates.implements.incoming] : []), ...(stacked ? [predicates.seeks.outgoing, predicates.supports_mission.incoming] : [])];
const patternGroup = groups.find((g) => g.heading === predicates.candidate_pattern.outgoing);
const perLink = [predicates.candidate_pattern.incoming, predicates.depends_on.outgoing, predicates.depends_on.incoming, predicates.works_with.outgoing, SOLUTIONS_NEEDING];
const shownGroups = groups.filter((g) => g !== patternGroup && !covered.includes(g.heading));
---
<Base title={element.title} description={element.description}>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href={href('')}>Home</a></li>
        <li><a href={href(`${element.typeInfo.section}/`)}>{element.typeInfo.plural}</a></li>
        <li aria-current="page">{element.title}</li>
      </ol>
    </nav>

    <header class="record-header" data-element={element.id}>
      <div class="record-header__meta">
        <TypeBadge type={element.type} />
        <StatusBadge status={element.status} />
        {element.type === 'mission' && scopeLabel(element.package) && <span class="scope-badge">{scopeLabel(element.package)}</span>}
        {pattern?.layer && <span class="approach-badge">{patternLayers[pattern.layer].label}</span>}
        {pattern?.sourcing && <span class="approach-badge">{pattern.sourcing}</span>}
        {group && <a class="approach-badge" href={group.url} title={group.hint}>{group.label}</a>}
      </div>
      <h1>{element.title}<LibraryMark element={element} always /></h1>
      {line && <p class="record-tagline">{line}</p>}
      <p class="lede">{element.description}</p>
      {element.canonicalUrl && (
        <p class="record-from">
          From {upstream!.title} {pkg.version} ·{' '}
          <a href={element.canonicalUrl} target="_blank" rel="noopener">See it in the library<span class="sr-only"> (opens in a new tab)</span></a>
        </p>
      )}
      {resource && (
        <p class="record-resource">
          <a class="button button--primary" href={resource.url} target="_blank" rel="noopener">Go to the {resource.kind.toLowerCase()}<span class="sr-only"> (opens in a new tab)</span></a>
          <span class="muted">By {resource.by ?? pkg.publisher.name}{resource.lastReviewedAt && <> · Checked {formatDate(resource.lastReviewedAt)}</>}</span>
        </p>
      )}
      {link && (
        <p class="record-resource">
          <a class="button button--primary" href={link.url} target="_blank" rel="noopener">Read about it<span class="sr-only"> (opens in a new tab)</span></a>
          <span class="muted">By {link.by ?? pkg.publisher.name}{link.lastReviewedAt && <> · Checked {formatDate(link.lastReviewedAt)}</>}</span>
        </p>
      )}
    </header>

    {stacked && <MissionExplorer blueprint={blueprint!} />}

    <div class="record-layout">
      <div class="record-main">
        {replacement && (
          <div class="notice">
            <p>This pattern has been replaced by <a href={replacement.url}>{replacement.title}</a>, which has it among its ways to source it.</p>
          </div>
        )}

        {canHaveResources && (
          <section class="section section--resources" data-resources-for={element.id}>{resources.length > 0 && <><h2>Resources</h2><p class="section-note">To learn more, or to get started.</p><ResourceList resources={resources} within={pkg} /></>}</section>
        )}

        {measures.length > 0 && (
          <section class="section">
            <h2>Measures</h2>
            <p class="section-note">Ways to tell how this outcome is going.</p>
            <dl class="measures">
              {measures.map((m) => (
                <div id={`measure-${m.id}`}>
                  <dt>{m.title}</dt>
                  <dd>{m.description}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        {principles.length > 0 && (
          <section class="section">
            <h2>Principles</h2>
            <p class="section-note">What the mission’s architecture should follow, whichever way each part is sourced.</p>
            <ol class="principles">{principles.map((s) => <li>{s}</li>)}</ol>
          </section>
        )}

        {blueprint && blueprint.outcomes.length > 0 && blueprint.capabilities.length > 0 && (
          <section class="section">
            <h2>How capabilities serve the outcomes</h2>
            <p class="section-note">Each dot is a capability that contributes to that outcome.</p>
            <OutcomeMatrix blueprint={blueprint} />
          </section>
        )}

        {element.applicabilityNotes && (
          <div class="notice">
            <p><strong>Applicability.</strong> {element.applicabilityNotes}</p>
          </div>
        )}

        {fields.length > 0 && (
          <div class="pattern-fields">
            {fields.map((f) => (
              <section class={`pattern-field pattern-field--${f.key}`}>
                <h2>{f.label}</h2>
                <ul>{f.items.map((s) => <li>{s}</li>)}</ul>
              </section>
            ))}
          </div>
        )}

        {(components.length > 0 || hosting) && (
          <section class="section">
            <h2>Components</h2>
            <p class="section-note">
              {hosting && <><strong>{hosting.label}.</strong> {hosting.hint} </>}
              {components.length > 0 ? 'The parts that run separately, by tier, with what each sends to and needs.' : 'Its parts aren’t listed yet.'}
            </p>
            {tiers.length > 0 && (
              <div class="components">
                {tiers.map((t) => (
                  <div class={`components__tier components__tier--${t.key}`}>
                    <h3>{t.label} <span class="muted">· {t.hint}</span></h3>
                    <dl>
                      {t.parts.map((c) => (
                        <div id={`component-${c.id}`}>
                          <dt>{c.title}{c.exposure === exposures.public && <span class="approach-badge">{c.exposure}</span>}</dt>
                          {c.description && <dd>{c.description}</dd>}
                          {c.technology && <dd>Built with {c.technology}</dd>}
                          {c.sendsTo.length > 0 && <dd>Sends to {c.sendsTo.map((o, i) => <>{i > 0 && ', '}<a href={`#component-${o.id}`}>{o.title}</a></>)}</dd>}
                          {c.needs.length > 0 && <dd>Connects to what fills {c.needs.map((n, i) => <>{i > 0 && ', '}<a href={n.url}>{n.title}</a></>)}</dd>}
                        </div>
                      ))}
                    </dl>
                  </div>
                ))}
              </div>
            )}
          </section>
        )}

        {pattern && (solutions || pattern.ways.length > 1) && (
          <section class="section">
            <h2>{solutions ? 'Solutions' : 'Ways to source it'}</h2>
            <p class="section-note">
              {solutions
                ? 'Example solutions that implement this pattern. Any of these can supply the parts above. Each has its own tradeoffs, and some need another pattern.'
                : 'Any of these can supply the parts above. Each has its own tradeoffs, and some need another pattern.'}
            </p>
            <div class="ways">
              {pattern.ways.map((w) => (
                <article class="way" id={`way-${w.id}`} data-element={w.solution?.id}>
                  <p class="way__approach">{w.approach}</p>
                  <h3>{w.solution ? <a href={w.solution.url}>{w.title}<LibraryMark element={w.solution} within={pkg} /></a> : w.title}</h3>
                  {w.description && <p>{w.description}</p>}
                  {w.fields.map((f) => (
                    <div class="way__field">
                      <h4>{f.label}</h4>
                      <ul>{f.items.map((s) => <li>{s}</li>)}</ul>
                    </div>
                  ))}
                  {w.needs.map((n) => (
                    <p class="way__needs">Needs <a href={n.pattern.url}>{n.pattern.title}</a>{n.note && <>. {n.note}</>}</p>
                  ))}
                </article>
              ))}
            </div>
          </section>
        )}

        {shownGroups.map((g) => {
          // Links between capabilities and patterns, and between patterns, each say something of their own,
          // such as a mission's caveat or how much of a capability a pattern covers.
          const perRow = perLink.includes(g.heading);
          const notes = perRow ? new Map([...g.links].flatMap(([id, l]) => (l.note ? [[id, l.note] as const] : []))) : undefined;
          const partial = perRow ? new Set([...g.links].flatMap(([id, l]) => (l.partial ? [id] : []))) : undefined;
          return (
            <section class="section">
              <h2>{g.heading}</h2>
              {!perRow && g.notes.map((n) => <p class="section-note">{n}</p>)}
              <ElementTable elements={g.elements} notes={notes} partial={partial} parents={g.parents} within={pkg} />
            </section>
          );
        })}

        {patternGroup && (
          <section class="section">
            <h2>Compare the candidate patterns</h2>
            <p class="section-note">
              Example approaches that might realize this capability, with when each one fits and what to watch for.
            </p>
            <PatternCompare capability={element} patterns={patternGroup.elements} />
          </section>
        )}

        {questions.length > 0 && (
          <section class="section">
            <h2>Discovery questions</h2>
            <p class="section-note">Answers to these questions point here.</p>
            <ul class="discovery-list">
              {questions.map(({ question, answers }) => (
                <li>
                  <a class="text-link" href={question.url}>{question.prompt}</a>
                  <ul>
                    {answers.map((a) => (
                      <li><strong>{a.label}.</strong> <span class="muted">{a.interpretation}</span></li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </section>
        )}

        {sources.length > 0 && (
          <section class="section">
            <h2>Sources</h2>
            <SourceList sources={sources} />
          </section>
        )}
      </div>

      <aside class="record-aside" aria-label="Details">
        <dl class="facts">
          <div><dt>ID</dt><dd><code class="element-id">{element.id}</code></dd></div>
          <div><dt>Type</dt><dd>{element.typeInfo.label}</dd></div>
          {element.status && <div><dt>Status</dt><dd>{statuses[element.status]}</dd></div>}
          <div>
            <dt>Package</dt>
            <dd>
              {pkg.title} <span class="muted">v{pkg.version}</span>
              <div>{element.canonicalUrl ? <a href={downloadUrl(pkg)} target="_blank" rel="noopener">Download JSON<span class="sr-only"> (opens in a new tab)</span></a> : <a href={downloadUrl(pkg)}>Download JSON</a>}</div>
            </dd>
          </div>
          {users.length > 0 && <div><dt>Also used by</dt><dd>{users.map((p) => p.title).join('; ')}</dd></div>}
          {scope.length > 0 && <div><dt>Scope</dt><dd>{scope.join('; ')}</dd></div>}
          {reviewed && <div><dt>Sources reviewed</dt><dd>{formatDate(reviewed)}</dd></div>}
          {attributes.length > 0 && (
            <div>
              <dt>Attributes</dt>
              <dd>
                {attributes.map(([key, value]) => (
                  <div>{attributeLabel(key)}: <span class="muted">{attributeValue(value)}</span></div>
                ))}
              </dd>
            </div>
          )}
        </dl>
      </aside>
    </div>
  </div>
</Base>

<style>
  .discovery-list { list-style: none; margin: 0; padding: 0; display: grid; gap: .9rem; }
  .discovery-list > li > a { font-weight: 600; }
  .discovery-list ul { margin: .3rem 0 0; padding-left: 1.1rem; display: grid; gap: .2rem; font-size: .95rem; }
  .approach-badge { font-size: .8125rem; font-weight: 600; padding: .15rem .55rem; border-radius: 999px; border: 1px solid var(--border); background: var(--surface-muted); }
  a.approach-badge { color: var(--text); text-decoration: none; }
  a.approach-badge:hover { border-color: var(--accent); color: var(--accent); }
  .pattern-fields { display: grid; gap: 1rem; margin-bottom: 2rem; }
  @media (min-width: 46rem) { .pattern-fields { grid-template-columns: 1fr 1fr; } }
  .pattern-field { padding: 1rem 1.15rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .pattern-field--parts, .pattern-field--watchFor { grid-column: 1 / -1; }
  .pattern-field h2 { margin: 0 0 .5rem; font-size: 1rem; }
  .pattern-field ul { margin: 0; padding-left: 1.1rem; display: grid; gap: .35rem; }
  .record-from { margin: 0 0 .75rem; color: var(--text-muted); font-size: .9375rem; }
  .section--resources { margin-bottom: 2rem; }
  .section--resources:empty { display: none; }
  .record-resource { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; margin: 0; }
  .measures { display: grid; gap: .9rem; margin: 0; max-width: 54rem; }
  .components { display: grid; gap: 1rem; max-width: 54rem; }
  .components__tier { border-left: 4px solid var(--border); padding-left: .9rem; }
  .components__tier--front { border-left-color: #0ea5e9; }
  .components__tier--service { border-left-color: #8b5cf6; }
  .components__tier--data { border-left-color: #f59e0b; }
  .components__tier h3 { font-size: .95rem; margin: 0 0 .4rem; }
  .components__tier h3 .muted { font-weight: 400; }
  .components dl { display: grid; gap: .7rem; margin: 0; }
  .components dt { font-weight: 650; display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
  .components dd { margin: .1rem 0 0; color: var(--text-muted); }
  .measures dt { font-weight: 650; }
  .measures dd { margin: .15rem 0 0; color: var(--text-muted); }
</style>
